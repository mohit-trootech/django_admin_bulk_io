# Node artifact files
node_modules/

# Databases
db.sqlite3

# Virtual Envs
.venv/*
.env/*

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

**/__pycache__
**/*.pyc
*development.py
*user_qualification_certificate/
*temp/


/media/*
django_admin_bulk_io/media/*

# coverage for unit test
/coverage.data
/coverage/
.coverage

static/temp/*
hr_management/static/temp/*
temp/*

# coverage for unit test
.env
/coverage.data
/coverage/
